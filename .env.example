# ──────────────────────────────────────────────────────────────
# BILLR — Netlify Frontend Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file -> .env for local development.
# On Netlify: add each variable under
#   Site Settings → Environment Variables

# Supabase — get from Supabase Dashboard → Project Settings → API
# The ANON KEY is safe on the frontend — security is enforced by Row Level Security (RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Render Backend URL — your deployed Render service URL (no trailing slash)
# e.g. https://billr-backend.onrender.com
VITE_API_BASE_URL=https://your-backend.onrender.com

# Admin email(s) for UI-level access control (comma-separated)
VITE_ADMIN_EMAILS=you@example.com
