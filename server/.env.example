# ──────────────────────────────────────────────────────────────
# BILLR — Render Backend Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy this file -> .env in your local server environment.
# On Render: add each of these under
#   Dashboard → Your Service → Environment → Add Environment Variable

# Supabase — get from Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key   # ⚠️ NEVER expose this to the frontend!

# Admin email(s) — comma-separated — only these users can view /api/logs
ADMIN_EMAILS=you@example.com

# Allowed CORS origins — comma-separated Netlify URL(s)
# e.g. https://billr-app.netlify.app,https://yourdomain.com
ALLOWED_ORIGINS=https://your-app.netlify.app

# Port — Render sets this automatically; only needed locally
PORT=3000

# Node environment
NODE_ENV=production
